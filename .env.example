# Copy this file to .env and adjust values as needed.
# The defaults below work out of the box for local development.

# Postgres credentials
POSTGRES_USER=imagefeed
POSTGRES_PASSWORD=imagefeed
POSTGRES_DB=imagefeed

# Host-side ports. Change these if something else on your machine is already using 5432 or 8080.
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# URLs the browser uses to reach the backend API and WebSocket. Update both if you changed BACKEND_PORT above.
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws